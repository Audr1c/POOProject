        <mxCell id="acc" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#D5D8DD;strokeWidth=1.2;fontFamily=TeX Gyre Heros,Helvetica,Arial;fontSize=19;fontColor=#1A1A1A;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;span style=&quot;font-family:Fira Mono,Consolas,monospace;font-size:85%&quot;&gt;accumulator += frame_time;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#7A8B99&quot;&gt;// temps réel écoulé&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Fira Mono,Consolas,monospace;font-size:85%&quot;&gt;&lt;span style=&quot;color:#7B3FA0&quot;&gt;while&lt;/span&gt; (accumulator &amp;gt;= dt) {&amp;nbsp;&lt;span style=&quot;color:#7A8B99&quot;&gt;// en retard ?&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Fira Mono,Consolas,monospace;font-size:85%&quot;&gt;&amp;nbsp;&amp;nbsp;scene-&amp;gt;step(dt);&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#7A8B99&quot;&gt;// un pas de 1/120 s&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Fira Mono,Consolas,monospace;font-size:85%&quot;&gt;&amp;nbsp;&amp;nbsp;accumulator -= dt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Fira Mono,Consolas,monospace;font-size:85%&quot;&gt;}&lt;/span&gt;&lt;/div&gt;" vertex="1">
